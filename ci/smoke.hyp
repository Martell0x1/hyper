# Stable CI smoke program (keep small and self-contained).
let nums = [1, 2, 3]
print(nums[0])
print(nums[1] + nums[2])

from pointmod import Point

let mut p = Point(x: 10, y: 20)
p.move(5, 5)
print(p.x)
print(p.y)

struct Counter:
    let mut value: i32

    fn __init__(ref self, start: i32):
        self.value = start

    fn label(ref self):
        return f"count={self.value}"

let c = Counter(value: 7)

struct Animal:
    let name: string

struct Dog:
    let animal: Animal
    let breed: string

let base = Animal(name: "Rex")
let dog = Dog(animal: base, breed: "Bulldog")
let a = dog.animal
print(a.name)
print(dog.breed)

fn add(a, b):
    return a + b

print(add(2, 3))
print(f"ok {add(1, 1)}")

fn boom():
    print("boom")
    return true

print(false and boom())
print(true or boom())
print(true and false)
print(false or true)

print(true, false, None)
print("multi", 1, 2.5, nums)

fn greet(who):
    return f"hi {who}"

fn nothing():
    return None

print(greet("Hyper"))
print(greet(nums[0]))
print(nothing())
print(f"greeting: {greet(\"CI\")}")

from strmod import shout
import strmod as sm

print(shout("loud"))
print(sm.pair("x", 2))
print(c.label())

# Values compare by content, not by address.
print("hyper" == "hyper")
print("hyper" != "rust")
print(greet("Hyper") == "hi Hyper")
print([1, 2] == [1, 2])
print([1, 2] == [1, 3])
print({"a": 1} == {"a": 1})
print(1 == 1.0)
print(None == None)

# Structs survive function returns and typed parameters.
struct Box:
    let mut size: i64

    fn __init__(ref self, size_val: i64):
        self.size = size_val

    fn grown(ref self, by: i64) -> Box:
        return Box(self.size + by)

fn make_box(size: i64) -> Box:
    return Box(size)

fn describe(b: Box):
    return f"box={b.size}"

let small = make_box(2)
let big = small.grown(3)
print(describe(small))
print(describe(big))
print(big.size)
