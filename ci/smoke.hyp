# Stable CI smoke program (keep small and self-contained).
let nums = [1, 2, 3]
print(nums[0])
print(nums[1] + nums[2])

from pointmod import Point

let mut p = Point(x: 10, y: 20)
p.move(5, 5)
print(p.x)
print(p.y)

struct Animal:
    let name: string

struct Dog:
    let animal: Animal
    let breed: string

let base = Animal(name: "Rex")
let dog = Dog(animal: base, breed: "Bulldog")
let a = dog.animal
print(a.name)
print(dog.breed)

fn add(a, b):
    return a + b

print(add(2, 3))
print(f"ok {add(1, 1)}")
