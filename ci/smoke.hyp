# Stable CI smoke program (keep small and self-contained).
let nums = [1, 2, 3]
print(nums[0])
print(nums[1] + nums[2])

from pointmod import Point

let mut p = Point(x: 10, y: 20)
p.move(5, 5)
print(p.x)
print(p.y)

struct Counter:
    let mut value: i32

    fn __init__(ref self, start: i32):
        self.value = start

    fn label(ref self):
        return f"count={self.value}"

let c = Counter(value: 7)

struct Animal:
    let name: string

struct Dog:
    let animal: Animal
    let breed: string

let base = Animal(name: "Rex")
let dog = Dog(animal: base, breed: "Bulldog")
let a = dog.animal
print(a.name)
print(dog.breed)

fn add(a, b):
    return a + b

print(add(2, 3))
print(f"ok {add(1, 1)}")

fn boom():
    print("boom")
    return true

print(false and boom())
print(true or boom())
print(true and false)
print(false or true)

print(true, false, None)
print("multi", 1, 2.5, nums)

fn greet(who):
    return f"hi {who}"

fn nothing():
    return None

print(greet("Hyper"))
print(greet(nums[0]))
print(nothing())
print(f"greeting: {greet(\"CI\")}")

from strmod import shout
import strmod as sm

print(shout("loud"))
print(sm.pair("x", 2))
print(c.label())
