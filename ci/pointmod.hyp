# Struct module for CI smoke (imported by smoke.hyp).
struct Point:
    let pub mut x: i32
    let pub mut y: i32

    pub fn __init__(ref self, x_val: i32, y_val: i32):
        self.x = x_val
        self.y = y_val

    pub fn move(ref self, dx: i32, dy: i32):
        self.x = self.x + dx
        self.y = self.y + dy
