# File handling and JSON smoke for CI (interpreter path).
# Writes into the current directory and cleans nothing up; CI runs in a temp checkout.
import json

with open("ci_smoke_io.txt", "w") as f:
    f.write("first\n")
    f.write("second\n")

with open("ci_smoke_io.txt", "r") as f:
    print(f.read())

with open("ci_smoke_io.txt", "r") as f:
    print(f.readline())
    print(f.readlines())

with open("ci_smoke_io.txt", "a") as f:
    f.write("third\n")

with open("ci_smoke_io.txt", "r+") as f:
    print(f.read(5))
    print(f.tell())
    f.write("HYPER")
    f.seek(0)
    print(f.readlines())
    print(f.size())

let handle = open("ci_smoke_io.txt", "r")
print(handle.readline())
handle.close()
print(handle.closed())

let config = {"name": "Hyper", "version": 1, "fast": true, "ratio": 2.5, "tags": ["io", "json"]}
print(json.dumps(config))
print(json.loads(json.dumps(config))["name"])

with open("ci_smoke_io.json", "w") as f:
    json.dump(config, f, 2)

with open("ci_smoke_io.json", "r") as f:
    print(f.read())

with open("ci_smoke_io.json", "r") as f:
    let loaded = json.load(f)
    print(loaded["version"])
    print(loaded["tags"])

with open_mmap("ci_smoke_io.txt") as mapped_file:
    print(mapped_file.read_chunk(0, 5))
    print(mapped_file.read_chunk(4096, 8))
