# Full string-method coverage on the compile path (Python-compatible).
let mut text = "  hello world  "
print(text.strip())
print(text.upper())
print(text.lower())
print(text.capitalize())
print(text.title())
print(text.swapcase())
print(text.startswith("  "))
print(text.endswith("world  "))
print(text.split())
print(text.split(" "))
print(text.rsplit(" "))
print(text.replace("hello", "Hyper"))
print(",".join(["a", "b", "c"]))
print(text.find("hello"))
print(text.rfind("o"))
print(text.count("l"))
print("42".isdigit())
print("Hi".isalpha())
print("Hi42".isalnum())
print("   ".isspace())
print("hi".islower())
print("HI".isupper())
print("Hello World".istitle())
print("abc".isascii())
print("hi".center(6, "*"))
print("hi".ljust(5, "-"))
print("hi".rjust(5, "-"))
print("42".zfill(5))
print("foobar".removeprefix("foo"))
print("foobar".removesuffix("bar"))
print("a.b.c".partition("."))
print("a.b.c".rpartition("."))
print(text.len())
