struct Point:
    let mut x: i32
    let mut y: i32

    fn __init__(ref self, x_val: i32, y_val: i32):
        self.x = x_val
        self.y = y_val

    fn move(ref self, dx: i32, dy: i32):
        self.x = self.x + dx
        self.y = self.y + dy

let mut p = Point(x: 10, y: 20)
p.move(5, 5)

print(p.x)
print(p.y)

# syntax